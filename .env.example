# ─────────────────────────────────────────────────────────────────
# Production RAG Chatbot — Environment Variables
# Copy to .env.development / .env.staging / .env.production
# ─────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────
APP_ENV=development
PROJECT_NAME=rag-production
VERSION=0.1.0
DEBUG=true
API_V1_STR=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── LLM (Inference) ──────────────────────────────────────────────
# Provider: openai | anthropic | ollama
LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2
MAX_TOKENS=2000
MAX_LLM_CALL_RETRIES=3

# OpenAI
OPENAI_API_KEY=sk-...

# Anthropic (optional)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (optional, local)
# OLLAMA_BASE_URL is the shared fallback for both LLM and embedding Ollama instances.
# Override per-role to run LLM and embedding models on separate GPUs / hosts.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# OLLAMA_LLM_BASE_URL=http://gpu0:11434      # LLM GPU (defaults to OLLAMA_BASE_URL)
# OLLAMA_EMBEDDING_BASE_URL=http://gpu1:11434 # Embedding GPU (defaults to OLLAMA_BASE_URL)

# OpenAI-compatible custom base URLs (empty = use official API)
# Use for vLLM, LM Studio, or any OpenAI-compatible proxy/gateway.
# LLM_BASE_URL=http://vllm-host:8000/v1
# ANTHROPIC_BASE_URL=http://anthropic-proxy:8080

# ── LLM (Evaluation — use stronger model to avoid bias) ──────────
EVALUATION_LLM=gpt-4o
EVALUATION_BASE_URL=https://api.openai.com/v1
EVALUATION_API_KEY=sk-...
EVALUATION_SLEEP_TIME=5

# ── Multilingual ──────────────────────────────────────────────────
# Primary language of indexed documents (BCP-47). Used to steer cross-lingual
# query rewriting so that retrieval keywords match the actual document text.
# Examples: "en" (English), "ja" (Japanese), "vi" (Vietnamese)
DOCUMENT_LANGUAGE=en

# Default answer language when the caller does not specify target_language.
# Can be overridden per-request via ChatRequest.target_language.
DEFAULT_TARGET_LANGUAGE=en

# ── Embedding ─────────────────────────────────────────────────────
# Provider: huggingface | openai | ollama
EMBEDDING_PROVIDER=huggingface
# IMPORTANT: Choose your embedding model based on document language.
# English-only documents:
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Japanese / multilingual documents — use a multilingual model instead:
# EMBEDDING_MODEL=BAAI/bge-m3                                      # 1024-dim, best quality
# EMBEDDING_MODEL=intfloat/multilingual-e5-large                   # 1024-dim, strong
# EMBEDDING_MODEL=intfloat/multilingual-e5-base                    # 768-dim, balanced
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2  # 768-dim
# NOTE: Changing EMBEDDING_MODEL requires re-indexing all documents in Qdrant.
EMBEDDING_BATCH_SIZE=32
# For OpenAI embeddings (can use a different key/URL than the LLM):
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_API_KEY=sk-...         # defaults to OPENAI_API_KEY
# EMBEDDING_BASE_URL=http://embed-host:8000/v1  # empty = official OpenAI

# ── Database (PostgreSQL + pgvector) ─────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ── Vector Store (Qdrant) ─────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=false

# ── RAG Configuration ─────────────────────────────────────────────
QDRANT_CHILD_COLLECTION=child_chunks
QDRANT_PARENT_COLLECTION=parent_store
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=20
PARENT_CHUNK_SIZE=1500
MAX_RETRIEVAL_K=5
RETRIEVAL_SCORE_THRESHOLD=0.70
MAX_SELF_CORRECTION_ITERATIONS=3
BASE_TOKEN_THRESHOLD=8000
TOKEN_GROWTH_FACTOR=1.5
MAX_QUERY_LENGTH=2000
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=["pdf","docx","txt","md"]

# ── LlamaIndex ────────────────────────────────────────────────────
LLAMAINDEX_SENTENCE_WINDOW_SIZE=3
LLAMAINDEX_SIMILARITY_TOP_K=5
LLAMAINDEX_AUTO_MERGE_CHUNK_SIZES=[2048,512,128]
# Parser mode: "markdown" (simpler) or "docling" (richer grounding with page/bbox info)
LLAMAINDEX_PARSER_MODE=markdown
# Max chunk size for embedding (must fit in embedding model context, e.g. 512 for BGE-small)
LLAMAINDEX_CHUNK_SIZE=400
LLAMAINDEX_CHUNK_OVERLAP=50

# ── Reranking (Cohere, optional) ──────────────────────────────────
COHERE_API_KEY=
RERANKER_MODEL=rerank-multilingual-v3.0
RERANKER_TOP_N=3
ENABLE_RERANKING=false

# ── Long-term Memory (mem0ai) ─────────────────────────────────────
MEM0_LLM_MODEL=gpt-4o-mini
MEM0_EMBEDDER_MODEL=text-embedding-3-small
LONG_TERM_MEMORY_COLLECTION=ltm_vectors
MAX_MEMORIES_PER_USER=50

# ── Auth (JWT) ────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-in-production-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# ── Observability (Langfuse) ──────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
# Self-hosted: LANGFUSE_HOST=http://localhost:3001

# ── Logging ───────────────────────────────────────────────────────
LOG_DIR=logs
LOG_LEVEL=DEBUG
LOG_FORMAT=console   # console | json

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=1000 per day, 200 per hour
RATE_LIMIT_CHAT=30 per minute
RATE_LIMIT_CHAT_STREAM=20 per minute
RATE_LIMIT_INGEST=10 per minute
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_LOGIN=20 per minute

# ── Grafana ───────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
